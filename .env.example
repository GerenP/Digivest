# ─── Server (Express) ───────────────────────────────────────────────
PORT=8787

# ─── Data pasar IDX (opsional) ──────────────────────────────────────
# Tanpa ini, Screener tampil dalam mode DATA CONTOH (diberi label jelas).
# JANGAN pernah memakai prefix VITE_ untuk kunci rahasia.
IDX_PROVIDER_BASE_URL=https://stock.arjum.com
IDX_PROVIDER_API_KEY=PASTE_YOUR_PROVIDER_KEY_HERE

# ─── AI Agent online (opsional, API kompatibel OpenAI Chat Completions) ──
# Tanpa ini, "Digi" menjawab dari materi edukasi bawaan (mode offline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ─── Frontend (opsional) ────────────────────────────────────────────
# Isi "off" bila situs di-host statis tanpa backend: aplikasi tidak akan memanggil /api sama sekali.
# VITE_BACKEND=off
